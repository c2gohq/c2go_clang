# c2go-bind emission for unmanaged_extern symbols (c2go section E) -- a
# bodyless c2go_extern function that calls into a host shared library.
#
# clang attaches a per-target `cabi` (parameter-passing descriptor) to each
# unmanaged_extern symbol; c2go-bind turns that into a Go dispatch wrapper:
# every argument is classified into a dl.Piece{} and the call goes through
# dl.Call() -- purego's SyscallN under CGO_ENABLED=0 (fakecgo). Resolution is
# a lazy Dlsym(RTLD_DEFAULT) cached in a uintptr. A capitalised alias exposes
# each symbol to external Go callers.
#
# The full chain (clang -> c2go-bind -> go build -> dlopen a real .so -> call
# -> assert) is exercised by .build_status/c2go_unmanaged_extern_e2e_gate.sh;
# this test pins the generated text.
#
# c2go-bind lives outside llvm-project; see lit.local.cfg for path discovery.

# RUN: rm -rf %t && split-file %s %t
# RUN: %c2gobind -dry-run %t/m.json | FileCheck %s --check-prefix=EXT
# RUN: %c2gobind -dry-run %t/m.json | FileCheck %s --check-prefix=NOEXT

# Dispatch is through the c2go-libc/dl package.
# EXT:      "github.com/c2gohq/c2go_libc/dl"

# Symbols are emitted name-sorted: ext_dscale, ext_mkpt, ext_printf,
# ext_read, ext_store.

# --- double arg + return: real FP dispatch (PFloat / F64bits / RFloat),
# not a panic stub -- section E covers floats end to end.
# EXT:      func ext_dscale(v float64, n int32) float64 {
# EXT:        {Class: dl.PFloat, Val: dl.F64bits(v)},
# EXT:      dl.Call(fn, _pieces, 0, dl.RFloat, nil, nil)
# EXT:      func ExtDscale(v float64, n int32) float64 {

# --- small by-value struct return (Pt{int,int} = 8 bytes): register-class
# RStruct dispatch with a retWord, written into the caller's &_ret. Large
# by-value structs stay fail-closed (c2go #529).
# EXT:      func ext_mkpt(x int32, y int32) Pt {
# EXT:      dl.RStruct, []dl.RetWord{
# EXT-SAME: unsafe.Pointer(&_ret))

# --- variadic: fixed param coerced, trailing ...any packed per arg.
# EXT:      func ext_printf(fmt *byte, _va ...any) int32 {
# EXT:        _pieces = append(_pieces, dl.Piece{Class: dl.PVararg, Val: _c2goVariadicArg(_a)})

# --- scalar: lazy Dlsym(RTLD_DEFAULT) cached, RInt dispatch, pointer args
# kept alive across the call.
# EXT:      func _c2goExtern_ext_read_resolve() uintptr {
# EXT:        fn, err := dl.Dlsym(dl.RTLD_DEFAULT, "ext_read")
# EXT:      func ext_read(fd int32, buf unsafe.Pointer, n uint64) int32 {
# EXT:      _a1, _ := dl.Call(fn, _pieces, 0, dl.RInt, nil, nil)
# EXT:      runtime.KeepAlive(buf)

# --- void return + write-through pointer arg.
# EXT:      func ext_store(p *int32, v int32) {
# EXT:      dl.Call(fn, _pieces, 0, dl.RVoid, nil, nil)

# --- the variadic packer: floats inside the ... list are rejected.
# EXT:      func _c2goVariadicArg(a any) uintptr {
# EXT:      phase 2.5: float in variadic args needs FP-aware dispatch

# The retired `external` package must never reappear (regression guard for
# the external.Call -> dl.Call leftover from the external->dl rename).
# NOEXT-NOT: external.

#--- m.json
{"linknames":[],"max_go_version":"go1.26","min_go_version":"go1.22","module_gcmask":{"vars":[]},"pkgpath":"demo","symbols":[{"abi":"abi0","argsize":24,"asm_symbol":"\u00b7ext_dscale","cabi":{"params":[{"pass":"direct","words":[{"f":true,"off":0,"sz":8}]},{"pass":"direct","words":[{"f":false,"off":0,"sz":4}]}],"ret":{"pass":"direct","words":[{"f":true,"off":0,"sz":8}]}},"go_name":"ExtDscale","go_sig":"func ext_dscale(v float64, n int32) float64","has_float":true,"kind":"unmanaged_extern","managed":true,"name":"ext_dscale","needs_linkname":true},{"abi":"abi0","argsize":16,"asm_symbol":"\u00b7ext_mkpt","cabi":{"params":[{"pass":"direct","words":[{"f":false,"off":0,"sz":4}]},{"pass":"direct","words":[{"f":false,"off":0,"sz":4}]}],"ret":{"pass":"direct","words":[{"f":false,"off":0,"sz":8}]}},"go_name":"ExtMkpt","go_sig":"func ext_mkpt(x int32, y int32) Pt","has_aggregate":true,"kind":"unmanaged_extern","managed":true,"name":"ext_mkpt","needs_linkname":true},{"abi":"abi0","argsize":16,"asm_symbol":"\u00b7ext_printf","cabi":{"params":[{"pass":"direct","words":[{"f":false,"off":0,"sz":8}]},{"pass":"direct","words":[{"f":false,"off":0,"sz":8}]}],"ret":{"pass":"direct","words":[{"f":false,"off":0,"sz":4}]}},"go_name":"ExtPrintf","go_sig":"func ext_printf(fmt *byte) int32","is_variadic":true,"kind":"unmanaged_extern","managed":true,"name":"ext_printf","needs_linkname":true},{"abi":"abi0","argsize":32,"asm_symbol":"\u00b7ext_read","cabi":{"params":[{"pass":"direct","words":[{"f":false,"off":0,"sz":4}]},{"pass":"direct","words":[{"f":false,"off":0,"sz":8}]},{"pass":"direct","words":[{"f":false,"off":0,"sz":8}]}],"ret":{"pass":"direct","words":[{"f":false,"off":0,"sz":4}]}},"go_name":"ExtRead","go_sig":"func ext_read(fd int32, buf unsafe.Pointer, n uint64) int32","kind":"unmanaged_extern","managed":true,"name":"ext_read","needs_linkname":true},{"abi":"abi0","argsize":16,"asm_symbol":"\u00b7ext_store","cabi":{"params":[{"pass":"direct","words":[{"f":false,"off":0,"sz":8}]},{"pass":"direct","words":[{"f":false,"off":0,"sz":4}]}],"ret":{"pass":"void"}},"go_name":"ExtStore","go_sig":"func ext_store(p *int32, v int32)","kind":"unmanaged_extern","managed":true,"name":"ext_store","needs_linkname":true}],"types":[{"go_def":"struct {\n\tx int32\n\ty int32\n}","linkage_owner":"c","managed_record":true,"name":"Pt"}]}
