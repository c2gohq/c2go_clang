# X86 raw SP-arithmetic loud-fail: negative trigger for the LEA-from-SP
# form of the SP-adjustment fatal in X86MCInstLower.
#
# The fatal originally matched only direct ADD/SUB-immediate-to-RSP forms.
# X86FrameLowering::BuildStackAdjustment selects `LEA64r %rsp, [%rsp+imm]`
# instead of ADD/SUB when STI.useLeaForSP() is true (CPU-tuning-dependent).
# The matcher was extended to catch the LEA-from-SP form too, and this MIR
# actually triggers the fatal so the defense is provably alive.
#
# Distinction vs the positive .ll companion (c2go-plan9-raw-sp-arith-loud-fail.ll):
#   - The .ll is positive production-path coverage: a strict-leaf goabi0cc
#     function whose prologue/epilogue SP-arith carries FrameSetup/
#     FrameDestroy flags and is not expected to trip.
#   - This .mir is the negative trigger: hand-crafted MIR that materializes
#     LEA64r %rsp, [%rsp+8] WITHOUT a FrameSetup/FrameDestroy flag inside a
#     c2go-argsize-tagged function - the matcher must report_fatal_error at
#     .s emission time.
#
# -start-before=x86-asm-printer drives the MIR straight into the AsmPrinter
# (X86MCInstLower::emitInstruction), bypassing any earlier pass that might
# reflag or rewrite the LEA. The fatal sets GenCrashDiag=false, so we use
# `not llc ... 2>&1 | FileCheck` (no --crash): report_fatal_error in
# non-crash mode exits non-zero with a clean LLVM ERROR message.
#
# RUN: not llc -start-before=x86-asm-printer \
# RUN:     -mtriple=x86_64-unknown-linux-gnu -output-asm-variant=2 \
# RUN:     -filetype=asm -o /dev/null %s 2>&1 | FileCheck %s
#
# CHECK: LLVM ERROR: X86 c2go: raw SP arithmetic
# CHECK-SAME: opcode #
# CHECK-SAME: emitted without FrameSetup/FrameDestroy flag
# CHECK-SAME: rsp_lea_no_flag
# CHECK-SAME: obj6.go deltasp algorithm does not track raw SUBQ/ADDQ/LEA $imm,SP
# CHECK-SAME: Wave AL.3

--- |
  ; A c2go-bucketed function (the c2go-argsize attr is what the matcher
  ; gates on). The IR body here is a stub; the AsmPrinter only touches the
  ; MIR below.
  define internal goabi0cc i64 @rsp_lea_no_flag() #0 {
  entry:
    ret i64 0
  }

  attributes #0 = { "c2go-argsize"="0" "c2go-boundary"="false" }

  !llvm.module.flags = !{!0}
  !0 = !{i32 1, !"c2go.goabi", i32 1}

...
---
name:            rsp_lea_no_flag
alignment:       16
tracksRegLiveness: true
frameInfo:
  stackSize:       0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  maxCallFrameSize: 0
fixedStack:      []
stack:           []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    ; LEA64r operand layout: {Rd, Base, Scale, Idx, Disp, Seg}. This is
    ; the exact shape X86FrameLowering::BuildStackAdjustment selects when
    ; useLeaForSP() is true. No frame-setup / frame-destroy flag is set on
    ; this LEA, so the matcher must fire.
    $rsp = LEA64r $rsp, 1, $noreg, 8, $noreg
    RET64 $noreg
...
