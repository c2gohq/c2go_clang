# A non-adjacent ADRP is printed immediately as the complete SB-relative
# address. A later ADDXri with the matching PAGEOFF must therefore copy that
# address instead of adding the symbol's low 12 bits again. The basic-block
# boundary deliberately clears the printer's register tracker, reproducing the
# optimized shape that first appeared while generating c2go-libc at -O2.
#
# RUN: llc %s -mtriple=arm64-unknown-none-goabi -start-after=branch-relaxation \
# RUN:   --output-asm-variant=2 -o - \
# RUN:   | FileCheck %s --implicit-check-not=PLAN9-ERROR

--- |
  target triple = "arm64-unknown-none-goabi"

  @pageoff_target = external global i8

  define ptr @split_pageoff() {
    ret ptr @pageoff_target
  }
...
---
name:            split_pageoff
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    $x8 = ADRP target-flags(aarch64-page) @pageoff_target
    B %bb.1

  bb.1:
    liveins: $x8
    $x0 = ADDXri $x8, target-flags(aarch64-pageoff, aarch64-nc) @pageoff_target, 0
    RET undef $lr, implicit $x0
...

# CHECK-LABEL: TEXT ·split_pageoff(SB)
# CHECK:       MOVD $·pageoff_target(SB), R8
# CHECK:       JMP [[CONT:_LBB[0-9]+_1]]
# CHECK:       [[CONT]]:
# CHECK-NEXT:  MOVD R8, R0
# CHECK-NEXT:  RET
